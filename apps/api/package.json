{
  "name": "@nexa/api",
  "version": "0.1.0-beta",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run build --workspace=@nexa/domain && tsc -p tsconfig.build.json && node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run test/unit",
    "test:coverage": "vitest run --coverage test/unit",
    "test:integration": "vitest run test/integration",
    "migrate": "node dist/scripts/migrate.js",
    "worker": "node dist/worker.js",
    "seed": "node dist/scripts/seed.js",
    "seed:fashion": "node dist/scripts/seed-fashion.js",
    "seed:sports": "node dist/scripts/seed-sports.js",
    "seed:all": "node dist/scripts/seed.js && node dist/scripts/seed-fashion.js && node dist/scripts/seed-sports.js",
    "bootstrap:admin": "node dist/scripts/bootstrap-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "11.1.8",
    "@nestjs/core": "11.1.8",
    "@nestjs/platform-express": "11.1.8",
    "@nestjs/swagger": "11.2.1",
    "@nexa/domain": "file:../../packages/domain",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.66.0",
    "@scalar/nestjs-api-reference": "^1.2.35",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.44.7",
    "jose": "6.1.2",
    "multer": "2.0.2",
    "pg": "8.16.3",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.4",
    "@types/multer": "2.0.0",
    "@types/node": "22.19.0",
    "@types/pg": "8.15.5",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
