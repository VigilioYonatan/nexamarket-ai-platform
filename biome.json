{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "apps/*/src/**",
      "packages/*/src/**",
      "apps/*/test/**",
      "packages/*/test/**",
      "tests/**",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!contracts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useExportType": "warn",
        "useImportType": "off",
        "noDescendingSpecificity": "off",
        "useNodejsImportProtocol": "warn"
      },
      "correctness": {
        "noUnusedFunctionParameters": "off",
        "noUnusedImports": "warn"
      },
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  }
}
