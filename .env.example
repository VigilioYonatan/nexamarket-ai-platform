# Copy to .env and replace all placeholders. Do NOT commit secrets.
NODE_ENV=development
APP_DOMAIN=marketplace.example.com
PUBLIC_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://nexa:REPLACE_THIS@localhost:5432/nexamarket
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_SECRET
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
KEYCLOAK_ISSUER=http://localhost:8080/identity/realms/nexamarket
KEYCLOAK_INTERNAL_BASE=http://localhost:8080/identity
KEYCLOAK_CLIENT_ID=nexamarket-bff
KEYCLOAK_CLIENT_SECRET=REPLACE_FROM_KEYCLOAK
MP_CLIENT_ID=REPLACE_FROM_MERCADO_PAGO
MP_CLIENT_SECRET=REPLACE_FROM_MERCADO_PAGO
MP_PUBLIC_KEY=REPLACE_FROM_MERCADO_PAGO
MP_REDIRECT_URI=http://localhost:5173/integrations/mercado-pago/oauth/callback
MP_WEBHOOK_SECRET=REPLACE_FROM_MERCADO_PAGO
MP_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS
SESSION_TTL_HOURS=12
INTERNAL_METRICS_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
AI_ENABLED=false
OLLAMA_MODEL=
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
APP_VERSION=0.2.0
